{
  "sql_injection": {
    "id": "SQLI-001",
    "name": "SQL Injection",
    "severity": "high",
    "description": "SQL injection attempts against query parameters or form data",
    "confidence": "high",
    "recommendation": "Use parameterized queries/prepared statements. Never concatenate user input into SQL.",
    "patterns": [
      "union(\\s|%20)+select",
      "(|%27)\\s*(or|OR)\\s*(|%27)?\\s*1\\s*=\\s*1",
      "(sleep\\(|benchmark\\()",
      "(--|#|;--|/\\*)\\s*$",
      "select(\\s|%20)+.*from(\\s|%20)+",
      "insert(\\s|%20)+into(\\s|%20)+",
      "delete(\\s|%20)+from(\\s|%20)+",
      "drop(\\s|%20)+(table|database)",
      "update(\\s|%20)+.*set(\\s|%20)+",
      "0x[0-9a-f]{8,}",
      "char\\(\\d{2,3}(,\\d{2,3})*\\)",
      "waitfor(\\s|%20)+delay(\\s|%20)+",
      "load_file\\s*\\(",
      "into(\\s|%20)+(out|dump)file\\s*\\(",
      "concat\\s*\\(",
      "group_concat\\s*\\(",
      "information_schema",
      "1%27%20OR%201%3D1",
      "1%27%20UNION%20SELECT",
      "1'%20OR%20'1'%3D'1'"
    ]
  },
  "xss": {
    "id": "XSS-001",
    "name": "Cross-Site Scripting",
    "severity": "high",
    "description": "Cross-site scripting attempts that could execute malicious script in a victim's browser",
    "confidence": "high",
    "recommendation": "Encode all user output, use Content-Security-Policy headers, validate input server-side.",
    "patterns": [
      "<script[^>]*>",
      "javascript:",
      "on(error|load|mouseover|focus|blur|click|dblclick|keydown|keyup|keypress|submit|change|input)\\s*=",
      "document\\.(cookie|write|location|domain)",
      "window\\.(location|open|eval|alert|confirm|prompt)",
      "<iframe[^>]*src\\s*=\\s*['\"]?data:",
      "data:text/html",
      "<svg[^>]*onload",
      "<img[^>]*onerror",
      "<body[^>]*onload",
      "<input[^>]*onfocus",
      "<marquee[^>]*onstart",
      "eval\\s*\\(",
      "String\\.(fromCharCode|raw)",
      "<a[^>]*href\\s*=\\s*['\"]?javascript:",
      "expression\\s*\\(",
      "vbscript:",
      "<object[^>]*data\\s*=\\s*['\"]?data:",
      "<embed[^>]*src\\s*=\\s*['\"]?data:",
      "innerHTML\\s*=",
      "document\\[.*\\]\\(.*\\)",
      "<meta[^>]*http-equiv\\s*=\\s*['\"]refresh",
      "prompt\\s*\\(",
      "confirm\\s*\\("
    ]
  },
  "directory_traversal": {
    "id": "TRAV-001",
    "name": "Directory Traversal",
    "severity": "high",
    "description": "Path traversal attempts to read files outside the web root",
    "confidence": "high",
    "recommendation": "Use chroot/jails, validate file paths against whitelists, never use user input in file operations.",
    "patterns": [
      "(\\.\\./|%2e%2e%2f|%2e%2e/){2,}.*(etc/passwd|etc%2fpasswd)",
      "(\\.\\./|%2e%2e%2f){2,}",
      "\\.\\./\\.\\./\\.\\./etc/passwd",
      "\\.\\./\\.\\./\\.\\.(windows|winnt)/win\\.ini",
      "%2e%2e%2f%2e%2e%2f%2e%2e%2f",
      "....//....//....//etc/passwd",
      "(\\.\\.\\\\){2,}.*(windows|winnt)",
      "\\\\windows\\\\win\\.ini",
      "\\\\etc\\\\passwd",
      "\\.env",
      "proc/self/environ",
      "proc/self/fd",
      "boot\\.ini",
      "web\\.config",
      "crossdomain\\.xml",
      "phpinfo\\.php",
      "wp-config\\.php",
      "wp-config\\.php\\.bak",
      "wp-config\\.php\\.old",
      "wp-config\\.php\\.txt",
      "config\\.php\\.bak",
      "config\\.php\\.old",
      "config\\.inc\\.php",
      "database\\.yml",
      "credentials\\.json"
    ]
  },
  "command_injection": {
    "id": "CMDI-001",
    "name": "Command Injection",
    "severity": "critical",
    "description": "Shell command injection / remote code execution attempts",
    "confidence": "high",
    "recommendation": "Never pass user input to shell commands. Use language-specific APIs instead of OS commands.",
    "patterns": [
      "(;|\\||&&)\\s*(cat|wget|curl|nc|bash|sh|whoami|id)\\b",
      "`.*`",
      "\\$\\(.*\\)",
      "\\|\\s*(cat|more|less|head|tail|grep|awk|sed)\\b",
      ";\\s*(rm|mv|cp|chmod|chown)\\s+-",
      "\\|\\s*(bash|sh|dash|ksh|zsh)\\b",
      "(;|\\||&&)\\s*(wget|curl)\\s+https?://",
      "env\\b.*=",
      ";\\s*(python|perl|ruby|node|php)\\s+",
      "\\|\\s*(python|perl|ruby|node|php)\\s+",
      "(;|\\||&&)\\s*(eval|exec|system|passthru|shell_exec|popen|proc_open)\\b",
      "cmd\\.exe\\s+/[ck]",
      "/bin/(ba)?sh\\s+-[ci]",
      ";\\s*sleep\\s+\\d",
      "\\|\\s*sleep\\s+\\d"
    ]
  },
  "log4shell": {
    "id": "LOG4-001",
    "name": "Log4Shell",
    "severity": "critical",
    "description": "Log4Shell JNDI lookup exploit attempt (CVE-2021-44228)",
    "confidence": "high",
    "recommendation": "Upgrade Log4j to >= 2.17.1. Remove JndiLookup class. Use WAF rules to block JNDI patterns.",
    "patterns": [
      "\\$\\{jndi:(ldap|rmi|dns)://",
      "\\$\\{lower:jndi",
      "\\$\\{upper:jndi",
      "\\$\\{::-j}.*\\$\\{::-n}.*\\$\\{::-d}.*\\$\\{::-i}",
      "\\$\\{\\$\\{::-j}.*\\$\\{::-n}.*\\$\\{::-d}.*\\$\\{::-i}",
      "\\$\\{jndi:ldaps?://",
      "\\$\\{jndi:rmi://",
      "\\$\\{jndi:dns://",
      "\\$\\{jndi:nis://",
      "\\$\\{jndi:nds://",
      "\\$\\{jndi:corba://",
      "\\$\\{jndi:iiop://",
      "\\$\\{\\$\\{.*\\}jndi:",
      "\\$\\{.*\\$\\{.*\\}.*\\}",
      "\\$\\{env:BARFOO:-j}.*\\$\\{env:BARFOO:-n}.*\\$\\{env:BARFOO:-d}",
      "\\$\\{date:j}.*\\$\\{date:n}.*\\$\\{date:i}",
      "\\$\\{::-\\$\\{::-j}.*\\$\\{::-n}.*\\$\\{::-d}.*\\$\\{::-i}"
    ]
  },
  "recon": {
    "id": "RECON-001",
    "name": "Reconnaissance",
    "severity": "low",
    "description": "Reconnaissance / scanning behavior - sensitive file probing or known scanner tooling",
    "confidence": "medium",
    "recommendation": "Block known scanner IPs, implement rate limiting, deploy WAF rules for common scanners.",
    "patterns": [
      "(\\.env$|\\.env\\.bak|\\.env\\.old|\\.env\\.local|\\.env\\.production)",
      "(\\.git/config|\\.git/HEAD|\\.gitignore)",
      "(wp-config\\.php|wp-config\\.php\\.bak|wp-login\\.php)",
      "(\\.htaccess|\\.htpasswd)",
      "(sqlmap|nikto|nmap|masscan|acunetix|nessus|burpsuite|owasp.*zap)",
      "(gobuster|dirbuster|feroxbuster|ffuf|wfuzz|dirsearch)",
      "(nuclei|httpx|subfinder|amass|masscan)",
      "(w3af|skipfish|arachni|appscan|qualys)",
      "(qualys|openvas|retina|iss.*internet.*scanner)",
      "(phpmyadmin|adminer|adminer\\.php)",
      "(server-status|server-info|server-config)",
      "(/wp-admin|/wp-includes|/wp-content)",
      "(phpinfo|info\\.php|test\\.php|debug\\.php)",
      "(\\.svn/entries|\\.svn/wc-db|\\.svn/db)",
      "(\\.hg/|hgrc|Mercurial)",
      "(WEB-INF/web\\.xml)",
      "(/config|/conf|/etc)\\.json",
      "(\\.aws/credentials|\\.dockerenv)",
      "(/debug|/actuator|/actuator/health|/actuator/env)"
    ]
  },
  "sensitive_data_access": {
    "id": "SENS-001",
    "name": "Sensitive Data Access",
    "severity": "high",
    "description": "Attempts to access sensitive files including .env, .git, backup, and configuration files",
    "confidence": "high",
    "recommendation": "Restrict access to sensitive files via web server config. Remove backup files from production. Use .gitignore properly.",
    "patterns": [
      "\\.env(\\.local|\\.production|\\.staging|\\.development|\\.backup)?$",
      "\\.git/(config|HEAD|logs|objects|refs|index|COMMIT_EDITMSG)",
      "\\.svn/(entries|wc-db|format)",
      "\\.hg/(store|00manifest|i/a|dirstate)",
      "wp-config(\\.php|\\.php\\.bak|\\.php\\.old|\\.php\\.txt|\\.php\\.swp)?$",
      "config(\\.json|\\.yml|\\.yaml|\\.xml|\\.ini|\\.bak|\\.old|\\.save)?$",
      "credentials(\\.json|\\.xml|\\.yml|\\.bak|\\.old)?$",
      "database(\\.yml|\\.yaml|\\.json|\\.bak|\\.sql)$",
      "\\.aws/(credentials|config)$",
      "\\.dockerenv$",
      "id_rsa(\\.pub)?$",
      "\\.ssh/(id_rsa|id_dsa|id_ecdsa|id_ed25519|authorized_keys|known_hosts)$",
      "\\.pgpass$",
      "\\.bash_history$",
      "\\.mysql_history$",
      "\\.psql_history$",
      "server\\.key$",
      "server\\.crt$",
      "\\.pem$",
      "\\.p12$",
      "\\.pfx$",
      "backup(\\.sql|\\.tar|\\.zip|\\.gz|\\.bak)$",
      "dump(\\.sql|\\.db|\\.sqlite|\\.sqlite3)?$",
      "db(\\.sqlite|\\.sqlite3|\\.bak|\\.old)?$",
      "debug\\.log$",
      "error\\.log$",
      "access\\.log$",
      "\\.cache/(tokens|credentials)",
      "service-account\\.json$",
      "keyfile\\.json$"
    ]
  },
  "suspicious_response": {
    "id": "SUSP-001",
    "name": "Suspicious Response Pattern",
    "severity": "medium",
    "description": "Unusual HTTP status codes from specific IPs may indicate enumeration, probing, or exploitation attempts",
    "confidence": "medium",
    "recommendation": "Monitor IPs with high rates of unusual status codes. Consider blocking persistent offenders.",
    "patterns": [
      "(422|500|501|502|503|504|505|507|508|510|511)",
      "(403.*\\.env|403.*\\.git|403.*wp-admin|403.*phpmyadmin)",
      "(404.*(\\.env|\\.git|config|backup|dump|\\.sql))",
      "(200.*(\\.env$|\\.git/config|id_rsa|credentials|\\.pem$))"
    ]
  }
}
