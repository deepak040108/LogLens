# LogLens Backend Environment Variables
# Copy this file to .env and adjust values as needed.

# --- Security ---
SECRET_KEY=change-me-in-production
RETENTION_HOURS=24

# --- Rate Limiting (requests per minute) ---
RATE_LIMIT_GENERAL=100
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_LOGIN=5

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

# --- Database ---
LOGLENS_DB_PATH=loglens.db

# --- GeoIP ---
# Download from https://www.maxmind.com/en/geolite2/signup (free account)
# Place .mmdb files in backend/geoip/
GEOIP_DB_PATH=geoip/GeoLite2-Country.mmdb
GEOIP_CITY_DB_PATH=geoip/GeoLite2-City.mmdb
GEOIP_ASN_DB_PATH=geoip/GeoLite2-ASN.mmdb

# --- Brute Force Detection ---
LOGLENS_BRUTE_FORCE_THRESHOLD=10
LOGLENS_BRUTE_FORCE_WINDOW_SECONDS=300

# --- Job Queue ---
LOGLENS_JOB_QUEUE=thread

# --- Server ---
PORT=4000
